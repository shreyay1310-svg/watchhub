# ==============================================================================
# WATCHHUB BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Server Core Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/watchhub

# 3. JWT & Session Security
JWT_ACCESS_SECRET=watchhub_super_secret_access_jwt_key_2026_luxury_chronograph
JWT_REFRESH_SECRET=watchhub_super_secret_refresh_jwt_key_2026_luxury_chronograph
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
OTP_HASH_SECRET=watchhub_sha256_hmac_secret_otp_encryption_key_2026

# 4. Razorpay Official Payment Gateway
# Obtain test/live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_watchhub2026
RAZORPAY_KEY_SECRET=watchhub_test_secret_key
RAZORPAY_WEBHOOK_SECRET=watchhub_razorpay_webhook_secret_key

# 5. Mobile SMS OTP Gateway (MSG91 & Fast2SMS)
# MSG91 Auth Key & DLT Registered Details: https://msg91.com
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=WTCHUB
MSG91_TEMPLATE_ID=your_dlt_template_id_here
FAST2SMS_API_KEY=your_fast2sms_api_key_fallback

# 6. Email OTP Gateway (Resend)
# Obtain API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="WatchHub Horology Atelier <concierge@watchhub.luxury>"

# 7. Google Maps Distance Matrix & Geocoding API (Backend server)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
