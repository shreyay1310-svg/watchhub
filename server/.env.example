# ==============================================================================
# WATCHHUB BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Server Core Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Database (Microsoft SQL Server 2025 via Prisma ORM)
DATABASE_URL="sqlserver://127.0.0.1:1433;database=WatchHubDB;user=watchhub_app;password=your_secure_password;trustServerCertificate=true"
# Windows Integrated Security alternative:
# DATABASE_URL="sqlserver://127.0.0.1:1433;database=WatchHubDB;integratedSecurity=true;trustServerCertificate=true"

# 3. JWT & Session Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET_CURRENT=your_hmac_sha256_current_secret_key_here
OTP_SECRET_PREVIOUS=your_hmac_sha256_previous_secret_key_here

# 4. Razorpay Official Payment Gateway
# Obtain test/live keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 5. Mobile SMS OTP Gateway (MSG91 & Fast2SMS)
ENABLE_PRODUCTION_SMS=false
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=WTCHUB
MSG91_TEMPLATE_ID=your_dlt_template_id_here
FAST2SMS_API_KEY=your_fast2sms_api_key_fallback

# 6. Email OTP Gateway (Google Gmail SMTP or Resend API)
# OPTION A: Google Gmail SMTP (Recommended - Free, No Domain Needed)
# 1. Go to Google Account > Security > Turn ON 2-Step Verification
# 2. Search "App passwords" > Create name "WatchHub" > Copy 16-character code
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# OPTION B: Resend API (Alternative)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="WatchHub Horology Atelier <concierge@watchhub.luxury>"

# 7. Google Maps Distance Matrix & Geocoding API (Backend server)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
