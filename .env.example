# ==============================================================================
# WATCHHUB ENTERPRISE ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database - Microsoft SQL Server 2025 via Prisma ORM
DATABASE_URL="sqlserver://127.0.0.1:1433;database=WatchHubDB;user=watchhub_app;password=your_secure_password;trustServerCertificate=true"
# Windows Integrated Security alternative:
# DATABASE_URL="sqlserver://127.0.0.1:1433;database=WatchHubDB;integratedSecurity=true;trustServerCertificate=true"

# JWT Authentication & OTP Cryptography Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
OTP_SECRET_CURRENT=your_hmac_sha256_otp_secret_key_64_hex_chars_here
OTP_SECRET_PREVIOUS=your_previous_hmac_secret_for_rotation_window_here

# Email Gateway (Google Gmail SMTP or Resend API)
EMAIL_SERVICE=gmail
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="WatchHub Horology Atelier <concierge@watchhub.luxury>"

# Mobile SMS Gateway (Fast2SMS & MSG91 - TRAI DLT Compliant)
ENABLE_PRODUCTION_SMS=false
FAST2SMS_API_KEY=your_fast2sms_api_key_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=WTCHUB
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# Google Maps Platform (Browser & Backend)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Official Payment Gateway (Test / Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Frontend Client Public Variables
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
