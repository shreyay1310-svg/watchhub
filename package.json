{
  "name": "watchhub",
  "version": "1.0.0",
  "type": "module",
  "description": "WatchHub – Premium Watches for Every Style (Production Full-Stack Platform)",
  "scripts": {
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "dev": "npm run dev --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start": "node server/src/server.js",
    "start:server": "npm start --prefix server",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "db:seed": "node server/scripts/seed_mssql_prisma.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.6.0",
    "prisma": "^6.19.3",
    "razorpay": "^2.9.8",
    "resend": "^6.38.1",
    "socket.io": "^4.8.4",
    "zod": "^3.24.1"
  },
  "keywords": [
    "watchhub",
    "ecommerce",
    "luxury-watches",
    "react",
    "node",
    "express",
    "mssql",
    "prisma",
    "rbac",
    "manufacturing-hub"
  ],
  "author": "WatchHub Architecture Team",
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "prisma": "^6.19.3"
  }
}
