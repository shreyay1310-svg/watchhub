# ==============================================================================
# WATCHHUB FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Backend REST & WebSocket Gateway Endpoint
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# 2. Google Maps JavaScript API Key
# Requires: Maps JavaScript API, Places API, Geocoding API
# Obtain from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# 3. Razorpay Standard Checkout Key ID (Public Client Key)
# Obtain test key from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=rzp_test_watchhub2026
